## Builds the absolute procedure URL, or an empty String when unusable.
func _build_url(procedure: String, query_input: String) -> String:
	var root := base_url.strip_edges()
	while root.ends_with("/"):
		root = root.substr(0, root.length() - 1)
	if root.is_empty():
		return ""
	if not root.begins_with("http://") and not root.begins_with("https://"):
		return ""
	var url := root + "/api/trpc/" + procedure
	if not query_input.is_empty():
		url += "?input=" + query_input.uri_encode()
	return url


## Reports a failure the request never got far enough to discover itself.
func _report_failure(on_complete: Callable, error: String) -> void:
	if on_complete.is_valid():
		on_complete.call(false, 0, "", error)


## Receives HTTPRequest's completion signal, frees the node and reports.
func _handle_completed(
	result: int,
	status_code: int,
	_headers: PackedStringArray,
	body: PackedByteArray,
	request: HTTPRequest,
	on_complete: Callable,
) -> void:
	request.queue_free()
	_in_flight -= 1

	if not on_complete.is_valid():
		return

	if result != HTTPRequest.RESULT_SUCCESS:
		on_complete.call(false, status_code, "", "the request failed (result %d)" % result)
		return

	var text := body.get_string_from_utf8()
	if status_code < 200 or status_code >= 300:
		on_complete.call(false, status_code, text, "Tentacle answered %d" % status_code)
		return

	on_complete.call(true, status_code, text, "")
